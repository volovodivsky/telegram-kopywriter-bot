# Скопіюй цей файл у .env і встав свої значення.

# 1) Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE

# 2) Твій Telegram ID (лише цифри) — ти адміністратор і підтверджуєш доступ інших.
#    Кілька адміністраторів — через кому: 111,222
ADMIN_IDS=PASTE_YOUR_TELEGRAM_ID_HERE

# 3) Ключ Anthropic API з console.anthropic.com
ANTHROPIC_API_KEY=PASTE_ANTHROPIC_API_KEY_HERE

# Необов'язково:
# BOT_CLAUDE_MODEL=claude-opus-5-5
# BOT_CLAUDE_EFFORT=high          # low | medium | high — вище = ретельніше, але довше
